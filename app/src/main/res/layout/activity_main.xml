<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Judul Form Pemesanan Tiket -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pemesanan Tiket"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Input NIK -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nomor Induk Kependudukan (NIK)"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etNik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan 16 digit NIK"
        android:inputType="number"
        android:minHeight="48dp"
        android:layout_marginBottom="16dp" />

    <!-- Input Nama Penumpang -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama Penumpang"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Masukkan nama lengkap penumpang"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:layout_marginBottom="24dp" />

    <!-- Tombol Pesan Tiket -->
    <Button
        android:id="@+id/btnSubmitBooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pesan Tiket" />

    <!-- TextView Status Pemesanan -->
    <TextView
        android:id="@+id/tvBookingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

</LinearLayout>
